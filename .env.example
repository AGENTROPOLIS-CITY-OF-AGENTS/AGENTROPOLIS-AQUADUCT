# 21st.dev
# Get this from your 21st account. Never commit the real value.
API_KEY_21ST=

# Unified MCP endpoint used by supported MCP clients.
MCP_21ST_URL=https://21st.dev/api/mcp

# AQUEDUCT agentd
# Real config stays local/operator-managed and contains PUBLIC testnet addresses only.
AQUEDUCT_AGENTD_CONFIG=config/agentd.dev.json
# true = one governed pass; preferred for Hermes cron/operator dispatch.
AQUEDUCT_AGENTD_ONCE=false
